PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/biometric_saas
JWT_SECRET=put-a-long-random-string-here
CLIENT_ORIGIN=http://localhost:5173

# Face service (must match face-service/.env)
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_KEY=put-the-same-key-as-face-service
# Set to false to skip the face check while developing
FACE_REQUIRED=true
