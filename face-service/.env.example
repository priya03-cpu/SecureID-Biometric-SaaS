# Must match FACE_SERVICE_KEY in server/.env
FACE_SERVICE_KEY=put-a-long-random-string-here

# Optional tuning
FACE_MODEL=Facenet512
FACE_DETECTOR=mtcnn
# Cosine distance: lower = stricter. Facenet512's published default is 0.30.
FACE_THRESHOLD=0.30
# Passive photo/screen-spoof check (extra model download, a little slower)
FACE_ANTI_SPOOF=false
